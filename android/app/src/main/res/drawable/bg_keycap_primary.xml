<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state with cyber-violet specular glow -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="#000000" />
                </shape>
            </item>
            <item android:top="2dp" android:bottom="0dp">
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="#7C3AED" />
                    <stroke android:width="1.5dp" android:color="#C084FC" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Normal primary keycap with purple accent depth -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="#4C1D95" />
                </shape>
            </item>
            <item android:bottom="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="#6D28D9" />
                    <stroke android:width="1dp" android:color="#8B5CF6" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
