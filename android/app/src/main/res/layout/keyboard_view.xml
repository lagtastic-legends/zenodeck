<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyboard_root"
    android:layout_width="match_parent"
    android:layout_height="@dimen/keyboard_total_height"
    android:orientation="vertical"
    android:background="#0E0F14"
    android:padding="@dimen/keyboard_padding">

    <!-- Top Morphing Utility Ribbon: Controls, Mode Pills & Status Indicator -->
    <LinearLayout
        android:id="@+id/layout_utility_ribbon"
        android:layout_width="match_parent"
        android:layout_height="@dimen/keyboard_ribbon_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp"
        android:paddingBottom="3dp">

        <!-- Left: Mode Switcher Pills ([⌨️ Keys], [⚡ Vault]) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="@dimen/keyboard_ribbon_pill_height"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btn_mode_vault"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/keyboard_ribbon_btn_height"
                android:background="@drawable/bg_utility_pill"
                android:text="⚡ Vault"
                android:textAllCaps="false"
                android:textColor="#22D3EE"
                android:textSize="@dimen/keyboard_text_size_ribbon"
                android:textStyle="bold"
                android:paddingHorizontal="8dp" />

            <Button
                android:id="@+id/btn_mode_keys"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/keyboard_ribbon_btn_height"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_utility_pill"
                android:text="⌨️ Keys"
                android:textAllCaps="false"
                android:textColor="#94A3B8"
                android:textSize="@dimen/keyboard_text_size_ribbon"
                android:paddingHorizontal="8dp" />
        </LinearLayout>

        <!-- Center: Host App & Live MIME Compatibility Indicator -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Live Host App MIME Compatibility Dot Indicator -->
                <View
                    android:id="@+id/view_mime_dot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_category_chip" />

                <TextView
                    android:id="@+id/tv_deck_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ZenoTap"
                    android:textColor="#F1F5F9"
                    android:textSize="@dimen/keyboard_text_size_title"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_rich_content_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_category_chip"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="1dp"
                    android:text="GIF • WebP Ready"
                    android:textColor="#10B981"
                    android:textSize="@dimen/keyboard_text_size_badge"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_keyboard_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Detecting host app capabilities..."
                android:textColor="#64748B"
                android:textSize="@dimen/keyboard_text_size_sub"
                android:ellipsize="end"
                android:maxLines="1" />

            <!-- Hidden/Preserved commit result tracker for status monitoring -->
            <TextView
                android:id="@+id/tv_commit_result"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ready for media injection"
                android:textColor="#94A3B8"
                android:textSize="8sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Key Echo Floating Preview Indicator (Pre-inflated, zero inflation lag) -->
        <TextView
            android:id="@+id/tv_key_echo_preview"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_utility_pill"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:text="◀ CURSOR"
            android:textColor="#22D3EE"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Right: Switch IME & Close Keyboard Buttons -->
        <ImageButton
            android:id="@+id/btn_switch_ime"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="2dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Switch Keyboard"
            android:src="@android:drawable/ic_menu_agenda"
            android:tint="#94A3B8" />

        <ImageButton
            android:id="@+id/btn_close_keyboard"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close Keyboard"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="#64748B" />
    </LinearLayout>

    <!-- Smart Clipboard Listener Strip with Headless Media3 Processing Indicator -->
    <LinearLayout
        android:id="@+id/layout_clipboard_pill"
        android:layout_width="match_parent"
        android:layout_height="@dimen/keyboard_clipboard_height"
        android:orientation="horizontal"
        android:background="@drawable/bg_utility_pill"
        android:paddingHorizontal="8dp"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_clipboard_preview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📋 Media in clipboard"
            android:textColor="#38BDF8"
            android:textSize="10sp"
            android:singleLine="true"
            android:ellipsize="end" />

        <!-- Headless Processing Spinner -->
        <ProgressBar
            android:id="@+id/pb_clipboard_processing"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="6dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_clip_compress"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:background="@drawable/bg_keycap_special"
            android:text="⚡ Compress"
            android:textAllCaps="false"
            android:textColor="#E2E8F0"
            android:textSize="9sp"
            android:paddingHorizontal="6dp" />

        <Button
            android:id="@+id/btn_clip_to_gif"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_keycap_special"
            android:text="🎞️ To GIF"
            android:textAllCaps="false"
            android:textColor="#C084FC"
            android:textSize="9sp"
            android:paddingHorizontal="6dp" />

        <Button
            android:id="@+id/btn_clip_to_sticker"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_keycap_special"
            android:text="✨ Sticker"
            android:textAllCaps="false"
            android:textColor="#34D399"
            android:textSize="9sp"
            android:paddingHorizontal="6dp" />
    </LinearLayout>

    <!-- Main Content Frame: Vault Tray & Category Filter Strip -->
    <FrameLayout
        android:id="@+id/media_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#12131A">

        <!-- Vault Tray Layout with Category Strip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Category Filter Strip: [All], [GIFs], [Stickers], [Pinned] -->
            <HorizontalScrollView
                android:id="@+id/scroll_category_filter"
                android:layout_width="match_parent"
                android:layout_height="@dimen/keyboard_category_strip_height"
                android:scrollbars="none"
                android:paddingHorizontal="4dp"
                android:paddingBottom="4dp">

                <LinearLayout
                    android:id="@+id/layout_category_filter"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/btn_cat_all"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:background="@drawable/bg_category_chip"
                        android:text="All"
                        android:textAllCaps="false"
                        android:textColor="#22D3EE"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="8dp" />

                    <Button
                        android:id="@+id/btn_cat_gifs"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_category_chip"
                        android:text="🎞️ GIFs"
                        android:textAllCaps="false"
                        android:textColor="#94A3B8"
                        android:textSize="9sp"
                        android:paddingHorizontal="8dp" />

                    <Button
                        android:id="@+id/btn_cat_stickers"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_category_chip"
                        android:text="✨ Stickers"
                        android:textAllCaps="false"
                        android:textColor="#94A3B8"
                        android:textSize="9sp"
                        android:paddingHorizontal="8dp" />

                    <Button
                        android:id="@+id/btn_cat_pinned"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_category_chip"
                        android:text="📌 Pinned"
                        android:textAllCaps="false"
                        android:textColor="#94A3B8"
                        android:textSize="9sp"
                        android:paddingHorizontal="8dp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- RecyclerView for Media Cards -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_gif_deck"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="vertical"
                android:visibility="visible" />
        </LinearLayout>

        <!-- Empty State View -->
        <LinearLayout
            android:id="@+id/layout_empty_deck"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ Vault Empty"
                android:textColor="#F1F5F9"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_deck_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center"
                android:text="Create or import GIFs &amp; Stickers in ZenoDeck studio to pin here for 1-tap messaging injection."
                android:textColor="#64748B"
                android:textSize="10sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_inject_gif"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_keycap_special"
                    android:text="🚀 Create Sample"
                    android:textAllCaps="false"
                    android:textColor="#22D3EE"
                    android:textSize="10sp"
                    android:paddingHorizontal="10dp" />

                <Button
                    android:id="@+id/btn_copy_fallback"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_keycap_special"
                    android:text="📋 Test Clip"
                    android:textAllCaps="false"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"
                    android:paddingHorizontal="10dp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom Action & 50% Spacebar Strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/keyboard_bottom_strip_height"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- App Launcher Deck Key (25% Width) -->
        <Button
            android:id="@+id/btn_open_app"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="@dimen/keyboard_key_height"
            android:layout_weight="0.25"
            android:background="@drawable/bg_keycap_special"
            android:text="⚡ ZenoDeck"
            android:textAllCaps="false"
            android:textColor="#E2E8F0"
            android:textSize="@dimen/keyboard_key_text_size"
            android:paddingHorizontal="4dp" />

        <!-- 50% Width Tactile Hardware Spacebar with Glowing LED Trackpad -->
        <Button
            android:id="@+id/btn_spacebar"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="@dimen/keyboard_key_height"
            android:layout_weight="0.5"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/bg_spacebar_50"
            android:text="Space"
            android:textAllCaps="false"
            android:textColor="#F1F5F9"
            android:textSize="@dimen/keyboard_key_text_size" />

        <!-- Switch Input Key (12% Width) -->
        <Button
            android:id="@+id/btn_switch_input"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="@dimen/keyboard_key_height"
            android:layout_weight="0.12"
            android:background="@drawable/bg_keycap_special"
            android:text="⌨"
            android:textAllCaps="false"
            android:textColor="#94A3B8"
            android:textSize="@dimen/keyboard_key_text_size"
            android:paddingHorizontal="2dp" />

        <!-- Tactile Backspace Key with Accelerate-on-hold and Swipe-to-delete (13% Width) -->
        <Button
            android:id="@+id/btn_backspace"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="@dimen/keyboard_key_height"
            android:layout_marginStart="3dp"
            android:layout_weight="0.13"
            android:background="@drawable/bg_keycap_special"
            android:text="⌫"
            android:textAllCaps="false"
            android:textColor="#F87171"
            android:textSize="@dimen/keyboard_key_text_size"
            android:textStyle="bold"
            android:paddingHorizontal="2dp" />
    </LinearLayout>

</LinearLayout>
